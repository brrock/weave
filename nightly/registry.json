    {
      "name": "weave",
      "type": "registry:component",
      "title": "Weave",
      "description": "Node-based canvas for React: pan/zoom/pinch, draggable nodes, ports, bezier edges, box select, viewport culling, minimap and controls.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "tooltip"
      ],
