        "switch"
      ],
      "files": [
        {
          "path": "src/components/weave-demo/workflow-editor.tsx",
          "type": "registry:component",
          "target": "components/weave-demo/workflow-editor.tsx"
        },
        {
          "path": "src/components/weave-demo/nodes.tsx",
          "type": "registry:component",
